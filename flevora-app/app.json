{
  "expo": {
    "name": "Flevora",
    "slug": "flevora-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/1000197996-rounded-433-433-433-433px.png",
    "scheme": "flevora",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sudeep098.flevoraapp",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/1000197996-rounded-433-433-433-433px.png",
        "backgroundColor": "#090612"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/1000197996-rounded-433-433-433-433px.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/1000197996-rounded-433-433-433-433px.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#090612"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7119d874-b3a1-4df4-bb62-c8c3829c9615"
      }
    }
  }
}
